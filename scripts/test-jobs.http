###
# Response Examples:
#
# Create Job Response:
# {
#   "success": true,
#   "data": {
#     "job": {
#       "id": "uuid",
#       "user_id": "uuid",
#       "prompt_id": "uuid",
#       "status": "pending",
#       "feed_ids": ["uuid1", "uuid2"],
#       "min_relevance_score": 70,
#       "export_format": "html",
#       "include_full_content": true,
#       "created_at": "2025-10-20T...",
#       "progress": 0
#     },
#     "message": "Job created and started. Use the progress endpoint to track status."
#   }
# }
#
# Progress SSE Stream:
# data: {"status":"running","progress":5,"currentStep":"Fetching RSS feeds","totalArticles":0}
# data: {"status":"running","progress":15,"currentStep":"Found 25 articles","totalArticles":25}
# data: {"status":"running","progress":30,"currentStep":"Scraped 10/25 articles","processedArticles":10}
# data: {"status":"running","progress":65,"currentStep":"Analyzed 15/25 articles","processedArticles":15}
# data: {"status":"completed","progress":100,"currentStep":"Completed","message":"Analysis complete! 18 relevant articles found."}
#
# Job Stats Response:
# {
#   "success": true,
#   "data": {
#     "totalJobs": 15,
#     "completedJobs": 12,
#     "failedJobs": 2,
#     "runningJobs": 1,
#     "totalArticlesAnalyzed": 350,
#     "totalCost": 2.45,
#     "averageDuration": 125.5
#   }
# }
###
