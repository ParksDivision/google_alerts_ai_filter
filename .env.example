# ============================================================================
# RSS Content Analyzer - Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Node Environment
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PORT=3001

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/rss_analyzer
DATABASE_URL=postgresql://postgres:password@localhost:5432/rss_analyzer

# Database connection pool settings
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
# Generate a strong secret key for JWT tokens
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing (bcrypt rounds)
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Claude AI Configuration (Primary)
# ----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxx

# Model selection: claude-haiku-4.5-20250929 (recommended), claude-sonnet-4.5-20250929, or claude-opus-4.5-20250929
# Haiku 4.5 is fastest and most cost-effective for article analysis
CLAUDE_MODEL=claude-haiku-4.5-20250929

# Token limits (Haiku 4.5 supports up to 8192 tokens output)
CLAUDE_MAX_TOKENS=8192

# Rate limits for Build tier (adjust based on your tier)
# Build tier: 50 RPM, 50k TPM, 5M TPD
# Free tier: 5 RPM, 20k TPM, 300k TPD (set to 5 if on free tier)
CLAUDE_REQUESTS_PER_MINUTE=50
CLAUDE_MAX_CONCURRENT=5

# Cost limits (in USD) - applied to all AI APIs (Claude + OpenAI)
# Claude Haiku 4.5: $0.80/1M input, $4.00/1M output
MONTHLY_COST_LIMIT=20.00

# ----------------------------------------------------------------------------
# OpenAI Configuration (Optional Fallback)
# ----------------------------------------------------------------------------
# Only used if CLAUDE_API_KEY is not set
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model selection: gpt-4o-mini (recommended), gpt-4o, or gpt-4-turbo
# Note: Adjust rate limits based on your OpenAI tier (Free/Tier 1 = 3 RPM, Tier 2+ = higher)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_REQUESTS_PER_MINUTE=3
OPENAI_MAX_CONCURRENT=1

# ----------------------------------------------------------------------------
# Application Paths
# ----------------------------------------------------------------------------
INPUT_DIR=./input
OUTPUT_DIR=./output

# ----------------------------------------------------------------------------
# RSS Feed Settings
# ----------------------------------------------------------------------------
RSS_FEEDS_FILE_PATH=./rss-feeds.csv
RSS_MAX_CONCURRENT=5
RSS_TIMEOUT=30000
RSS_DELAY=2000
RSS_RETRIES=3

# ----------------------------------------------------------------------------
# Web Scraper Settings
# ----------------------------------------------------------------------------
SCRAPER_MAX_CONCURRENT=10
SCRAPER_TIMEOUT=30000
SCRAPER_DELAY=1000
SCRAPER_RETRIES=3
USE_PROXY=false

# ----------------------------------------------------------------------------
# Export Settings
# ----------------------------------------------------------------------------
DEFAULT_EXPORT_FORMAT=html
INCLUDE_FULL_CONTENT=true
EXPORT_CHUNK_SIZE=500
MIN_RELEVANCE_SCORE=0

# ----------------------------------------------------------------------------
# Performance Settings
# ----------------------------------------------------------------------------
ENABLE_BATCHING=true
BATCH_SIZE=2
LOW_MEMORY_MODE=false

# ----------------------------------------------------------------------------
# Frontend Configuration
# ----------------------------------------------------------------------------
# CORS configuration - Set this to your frontend URL
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Security & Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Production Settings (uncomment for production)
# ----------------------------------------------------------------------------
# NODE_ENV=production
# DATABASE_URL=your-production-database-url
# JWT_SECRET=your-production-jwt-secret
# FRONTEND_URL=https://your-frontend-domain.com
